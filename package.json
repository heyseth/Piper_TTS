{
  "publisher": "sethmiller",
  "name": "piper-tts",
  "displayName": "Piper TTS",
  "description": "High-quality local text to speech with Piper",
  "icon": "images/icon.png",
  "version": "1.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyseth/Piper_TTS"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "extensionKind": ["workspace"],
  "enabledApiProposals": [],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:piper-tts.readAloud",
    "onCommand:piper-tts.increaseSpeed",
    "onCommand:piper-tts.decreaseSpeed",
    "onCommand:piper-tts.stopPlayback",
    "onCommand:piper-tts.selectVoice",
    "onCommand:piper-tts.downloadVoice",
    "onCommand:piper-tts.removeVoice",
    "onStartupFinished"
  ],
  "exports": {
    "piper-tts": {
      "default": "./out/extension.js"
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Piper TTS",
      "properties": {
        "piper-tts.voice": {
          "type": "string",
          "default": "en_US-hfc_female-medium",
          "description": "Voice model to use for text-to-speech. Use the 'Piper TTS: Select Voice' command to change."
        },
        "piper-tts.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "Playback speed for text-to-speech (1 = normal, higher = faster, lower = slower). Adjust on the fly with Alt+] (faster) and Alt+[ (slower)."
        }
      }
    },
    "commands": [
      {
        "command": "piper-tts.readAloud",
        "title": "Read Aloud Text",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.stopPlayback",
        "title": "Stop Reading",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.selectVoice",
        "title": "Select Voice",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.downloadVoice",
        "title": "Download Voice",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.removeVoice",
        "title": "Remove Voice",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.increaseSpeed",
        "title": "Increase Speed",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.decreaseSpeed",
        "title": "Decrease Speed",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_0_5",
        "title": "0.5×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_0_75",
        "title": "0.75×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_1",
        "title": "1× (Normal)",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_1_25",
        "title": "1.25×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_1_5",
        "title": "1.5×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_1_75",
        "title": "1.75×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_2",
        "title": "2×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_2_5",
        "title": "2.5×",
        "category": "Piper TTS"
      },
      {
        "command": "piper-tts.setSpeed_3",
        "title": "3×",
        "category": "Piper TTS"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "piper-tts.readAloud",
          "group": "1_modification"
        },
        {
          "command": "piper-tts.stopPlayback",
          "group": "1_modification",
          "when": "piper-tts.isPlaying"
        },
        {
          "submenu": "piper-tts.speedSubmenu",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "piper-tts.readAloud",
          "when": "editorHasSelection"
        },
        {
          "command": "piper-tts.stopPlayback",
          "when": "piper-tts.isPlaying"
        },
        {
          "command": "piper-tts.selectVoice"
        },
        {
          "command": "piper-tts.downloadVoice"
        },
        {
          "command": "piper-tts.removeVoice"
        },
        {
          "command": "piper-tts.increaseSpeed"
        },
        {
          "command": "piper-tts.decreaseSpeed"
        },
        {
          "command": "piper-tts.setSpeed_0_5",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_0_75",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_1",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_1_25",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_1_5",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_1_75",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_2",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_2_5",
          "when": "false"
        },
        {
          "command": "piper-tts.setSpeed_3",
          "when": "false"
        }
      ],
      "piper-tts.speedSubmenu": [
        {
          "command": "piper-tts.setSpeed_0_5",
          "group": "speed@1"
        },
        {
          "command": "piper-tts.setSpeed_0_75",
          "group": "speed@2"
        },
        {
          "command": "piper-tts.setSpeed_1",
          "group": "speed@3"
        },
        {
          "command": "piper-tts.setSpeed_1_25",
          "group": "speed@4"
        },
        {
          "command": "piper-tts.setSpeed_1_5",
          "group": "speed@5"
        },
        {
          "command": "piper-tts.setSpeed_1_75",
          "group": "speed@6"
        },
        {
          "command": "piper-tts.setSpeed_2",
          "group": "speed@7"
        },
        {
          "command": "piper-tts.setSpeed_2_5",
          "group": "speed@8"
        },
        {
          "command": "piper-tts.setSpeed_3",
          "group": "speed@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piper-tts.increaseSpeed",
        "key": "alt+]",
        "when": "editorTextFocus || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      },
      {
        "command": "piper-tts.decreaseSpeed",
        "key": "alt+[",
        "when": "editorTextFocus || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      }
    ],
    "submenus": [
      {
        "id": "piper-tts.speedSubmenu",
        "label": "Reading Speed"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
